# Copier en .env puis adapter. Lu automatiquement par docker compose.

# ─── Ports exposés sur la machine (dev) ───
HTTP_PORT=8080        # application : front + /api
POSTGRES_PORT=5432    # accès direct à la base (DBeaver, TablePlus…)
MAILPIT_PORT=8025     # interface web des emails capturés

# ─── Base de données ───
POSTGRES_VERSION=16
POSTGRES_DB=diaverum
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ─── Production ───
# Les variables de production se définissent dans Coolify : voir .env.prod.example et DEPLOYMENT.md.
