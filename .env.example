# Copier en .env puis adapter. Lu automatiquement par docker compose.

# ─── Ports exposés sur la machine (dev) ───
HTTP_PORT=8080        # application : front + /api
POSTGRES_PORT=5432    # accès direct à la base (DBeaver, TablePlus…)
MAILPIT_PORT=8025     # interface web des emails capturés

# ─── Base de données ───
POSTGRES_VERSION=16
POSTGRES_DB=diaverum
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ─── Production uniquement (obligatoires avec compose.prod.yaml) ───
# APP_SECRET=          # openssl rand -hex 32
# MAILER_DSN=smtp://user:pass@smtp.exemple.fr:587
# MAILER_FROM=noreply@diaverum.fr
# JWT_PASSPHRASE=       # openssl rand -hex 32 (protège la clé de signature des jetons)
# CONTENT_API_TOKEN=    # jeton du prestataire de contenus (openssl rand -hex 32), vide = intégration désactivée
# ALLOWED_IPS=          # liste blanche : IP de sortie des centres, ex. 203.0.113.10,198.51.100.0/24 (vide = tout le monde)
# TRUSTED_PROXIES=      # répartiteur de charge en amont de Nginx, ex. 10.0.0.0/8
