        {
            "id": "p16",
            "title": "Quiz de fin de module — question 4/4",
            "blocks": [
                {
                    "id": "s1-q6",
                    "type": "quiz",
                    "options": [
                        {
                            "id": "s1-q6-1",
                            "label": "Permettent de faire connaître aux équipes de soins vos choix sur le sujet de la fin de vie.\n",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q6-2",
                            "label": "Permettent de savoir si vous acceptez ou non une greffe de rein.\n",
                            "isCorrect": false
                        },
                        {
                            "id": "s1-q6-3",
                            "label": "Sont confidentielles et soumises au secret médical.\n",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q6-4",
                            "label": "Peuvent être annulées ou modifiées à tout moment.\n",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q6-5",
                            "label": "Doivent obligatoirement être renseignées pour tout patient dialysé.",
