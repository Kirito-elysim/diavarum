                        {
                            "id": "s1-pc-designee-2",
                            "label": "Non",
                            "isCorrect": true
                        }
                    ],
                    "question": "Lors de votre arrivée au centre, vous avez rempli le formulaire de la personne de confiance. \n**Avez-vous désigné quelqu’un ?**",
                    "questionType": "qcu"
