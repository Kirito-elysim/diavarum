                        },
                        {
                            "id": "s1-q3-2",
                            "label": "Transmettre à l’équipe de soins des informations strictement exactes concernant votre santé.",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q3-3",
                            "label": "Suivre exactement les prescriptions et sinon, le signaler immédiatement. ",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q3-4",
                            "label": "Signaler tout changement de situation médicale (traitement, symptôme, médecin…).\n",
                            "isCorrect": true
                        }
                    ],
                    "question": "**En tant que patient, vous devez :**",
                    "questionType": "qcm"
                }
            ]
        },
        {
            "id": "p14",
