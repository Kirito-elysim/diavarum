            "blocks": [
                {
                    "id": "s1-q4",
                    "type": "quiz",
                    "options": [
                        {
                            "id": "s1-q4-1",
                            "label": "Prendre les décisions médicales importantes à votre place.\n",
                            "isCorrect": false
                        },
                        {
                            "id": "s1-q4-2",
                            "label": "Désigner un interlocuteur privilégié auprès de l’équipe de soins parmi votre entourage.\n",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q4-3",
                            "label": "Faire connaître vos volontés si vous n’êtes pas en état de les exprimer.\n",
                            "isCorrect": true
                        },
                        {
                            "id": "s1-q4-4",
                            "label": "Obliger cette personne à vous accompagner lors de toutes vos consultations.\n",
                            "isCorrect": false
