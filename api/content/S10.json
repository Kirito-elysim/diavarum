    {
      "id": "s10-p13",
      "title": "Exercices de fin de module — 2/3",
      "blocks": [
        {
          "id": "s10-p13-b1",
          "type": "quiz",
          "questionType": "qcm",
          "question": "**Cochez les règles à respecter pour réaliser correctement une automesure de tensionnelle.**",
          "graded": true,
          "showCorrection": true,
          "options": [
            {
              "id": "c0",
              "label": "Maintenir le bras au niveau du cœur",
              "isCorrect": true
            },
            {
              "id": "c1",
              "label": "Rester assis, voire couché, au moins 5 minutes avant la mesure",
              "isCorrect": true
            },
            {
              "id": "c2",
              "label": "Ne pas boire de café, ni fumer dans les 30 minutes avant la mesure",
              "isCorrect": true
            },
            {
              "id": "c3",
              "label": "Ne pas boire plus de 300 ml d’eau avant la mesure",
              "isCorrect": false
            }
          ]
        }
      ]
    },
    {
      "id": "s10-p14",
      "title": "Exercices de fin de module — 3/3",
      "blocks": [
