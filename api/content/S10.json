    {
      "id": "s10-p03",
      "title": "POURQUOI SURVEILLER SA TENSION LORSQUE L'ON EST DIALYSÉ ? 1/2",
      "blocks": [
        {
          "id": "s10-p03-b1-box1110",
          "type": "info-card",
          "variant": "important",
          "title": "Important",
          "content": "L'hypertension artérielle est fréquente chez les patients atteints d'insuffisance rénale."
        },
        {
          "id": "s10-p03-b1",
          "type": "flip-cards",
          "question": "Une tension trop élevée peut favoriser :",
          "cards": [
            {
              "id": "c1",
              "front": "CARTE 1",
              "back": "Les maladies cardiovasculaires"
            },
            {
              "id": "c2",
              "front": "CARTE 2",
              "back": "L'insuffisance cardiaque"
            },
            {
              "id": "c3",
              "front": "CARTE 3",
              "back": "L'accident vasculaire cérébral (AVC)"
            },
            {
              "id": "c4",
              "front": "CARTE 4",
              "back": "L'aggravation de certaines complications rénales"
            }
          ]
        }
      ]
    },
    {
      "id": "s10-p04",
      "title": "POURQUOI SURVEILLER SA TENSION LORSQUE L'ON EST DIALYSÉ ? 2/2",
      "blocks": [
        {
          "id": "s10-p04-b1",
          "type": "flip-cards",
          "question": "Une tension trop basse peut entraîner :",
          "cards": [
            {
              "id": "c1",
              "front": "CARTE 1",
              "back": "Des vertiges"
            },
            {
              "id": "c2",
              "front": "CARTE 2",
              "back": "Des malaises"
            },
            {
              "id": "c3",
              "front": "CARTE 3",
              "back": "Des chutes"
            },
            {
              "id": "c4",
              "front": "CARTE 4",
              "back": "Une mauvaise tolérance des séances de dialyse"
            }
          ]
        },
        {
          "id": "s10-p04-b1-box1124",
          "type": "info-card",
          "variant": "important",
          "title": "Important",
          "content": "La surveillance tensionnelle permet d'adapter le traitement et le poids sec. Par exemple, si trop d’eau est retirée en dialyse et que l’on passe en dessous du poids sec, la tension peut chuter."
        }
      ]
    },
