          "type": "quiz",
          "questionType": "qcu",
          "question": "**Que signifie la règle des « 3 » ?**",
          "graded": true,
          "showCorrection": true,
          "options": [
            {
              "id": "c0",
              "label": "mesures le matin, 3 mesures le soir, pendant 3 jours consécutifs",
              "isCorrect": true
            },
            {
              "id": "c1",
              "label": "cm au dessus du coude, à 3 mn d'intervalle, 3 fois dans la journée",
              "isCorrect": false
            },
            {
              "id": "c2",
              "label": "mn aprés le réveil, dans 3 position différente (assis, debout, couché), 3 jours par semaine",
              "isCorrect": false
            }
          ]
        }
      ]
