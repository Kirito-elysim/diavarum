    {
      "id": "s10-p07",
      "title": "QU'EST-CE QUE L'AUTOMESURE TENSIONNELLE ?",
      "blocks": [
        {
          "id": "s10-p07-b1",
          "type": "image-text",
          "size": "image",
          "imageSide": "left",
          "verticalAlign": "center",
          "imageWidth": "half",
          "imageMaxHeight": 340,
          "imageUrl": "/courses/S10/p7.png",
          "alt": "QU'EST-CE QUE L'AUTOMESURE TENSIONNELLE ?",
          "content": "L'automesure consiste à **mesurer soi-même sa tension artérielle à domicile** à l'aide d'un tensiomètre électronique (acheté en pharmacie).\nElle permet de :\nobtenir des mesures dans les conditions de vie habituelles ;\nsuivre l'évolution de la tension ;\naider le médecin à adapter les traitements ;\nde participer activement à ma prise en charge.",
          "imageMaxWidth": 493
        }
      ]
    },
    {
      "id": "s10-p08",
      "title": "COMMENT RÉALISER CORRECTEMENT UNE AUTOMESURE ? 1/2",
      "blocks": [
        {
          "id": "s10-p08-b1",
          "type": "flip-cards",
          "question": "Avant de réaliser une automesure, il est conseillé de :",
          "cards": [
            {
              "id": "c1",
              "front": "CARTE 1",
              "back": "Rester au repos pendant 5 minutes."
            },
            {
              "id": "c2",
              "front": "CARTE 2",
              "back": "Éviter le café, le tabac dans les 30 minutes précédentes."
            },
            {
              "id": "c3",
              "front": "CARTE 3",
              "back": "Un effort physique dans les 30 minutes précédentes."
            },
            {
              "id": "c4",
              "front": "CARTE 4",
              "back": "Vider sa vessie si nécessaire."
            }
          ]
        }
      ]
    },
