    {
      "id": "s4-p04",
      "title": "Qu’est-ce que l’insuffisance rénale chronique terminale ? 3/3",
      "blocks": [
        {
          "id": "s4-p04-b2",
          "type": "info-card",
          "title": "Définition",
          "content": "L’insuffisance rénale chronique terminale est une diminution progressive et irréversible de la fonction rénale.",
          "variant": "definition"
        },
        {
          "id": "s4-p04-b1",
          "alt": "Illustration d’un patient",
          "size": "image",
          "type": "image-text",
          "content": "L’IRCT peut entraîner :\n– fatigue importante ;\n– perte d’appétit ;\n– démangeaisons ;\n– essoufflement ;\n– hypertension artérielle ;\n– œdèmes ;\n– troubles biologiques (potassium, phosphore, hémoglobine).",
          "imageUrl": "/courses/S4/p4.png",
          "imageSide": "left",
          "verticalAlign": "center"
        }
      ]
    },
