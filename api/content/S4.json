    {
      "id": "s4-p06",
      "title": "Qu’est-ce que l’hémodialyse ?",
      "blocks": [
        {
          "id": "s4-p06-info",
          "type": "info-card",
          "title": "Définition",
          "content": "L’hémodialyse permet de **nettoyer le sang** grâce à une machine et à un **filtre appelé dialyseur**. Elle remplace une partie du travail des reins mais ne guérit pas l’IRCT.",
          "variant": "definition"
        },
        {
          "id": "s4-p06-b1",
          "alt": "Patient relié à une machine d’hémodialyse",
          "type": "hotspot",
          "hotspots": [
            {
              "x": 62,
              "y": 25,
              "id": "r1",
              "size": 40,
              "label": "1",
              "description": "En séance, le sang passe dans le dialyseur."
            },
            {
              "x": 55,
              "y": 17,
              "id": "r2",
              "size": 40,
              "label": "2",
              "description": "Les déchets sont éliminés."
            },
            {
              "x": 55,
              "y": 40,
              "id": "r3",
              "size": 40,
              "label": "3",
              "description": "L’excès d’eau est retiré."
            },
            {
              "x": 62,
              "y": 68,
              "id": "r4",
              "size": 40,
              "label": "4",
              "description": "Le sang épuré est réinjecté dans l’organisme."
            }
          ],
          "imageUrl": "/courses/S4/p6.png",
